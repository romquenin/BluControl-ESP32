+static uint8_t vmu_uuid_kind(const uint8_t *uuid) {
+    if (memcmp(uuid, vmu_uuid_base, 12) || memcmp(uuid + 13, vmu_uuid_base + 13, 3)) {
+        return 0;
+    }
+    return uuid[12];
+}
 
