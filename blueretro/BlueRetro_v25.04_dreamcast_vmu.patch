diff --git a/main/system/crashlog.c b/main/system/crashlog.c
new file mode 100644
index 0000000..eed17cf
--- /dev/null
+++ b/main/system/crashlog.c
@@ -0,0 +1,140 @@
+/*
+ * Crash recorder for the Dreamcast VMU build.
+ *  - tick hook (IRAM, runs even during flash access): longest run of one task,
+ *    longest run with the scheduler suspended, with the VMU breadcrumb;
+ *  - task watchdog alarm: task that was running;
+ *  - software crash: PC, return address and exception cause.
+ * Kept in RTC memory (survives every reset except power off), the previous
+ * boot's record is shown on blueretro.io next to the version.
+ */
+#include <stdio.h>
+#include <string.h>
+#include <esp_attr.h>
+#include <esp_freertos_hooks.h>
+#include <esp_system.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <xtensa_context.h>
+#include "esp_private/panic_internal.h"
+#include "crashlog.h"
+
+#define CL_MAGIC 0xB10C0DE5
+
+RTC_NOINIT_ATTR crashlog_t cl_live;
+static crashlog_t cl_prev;
+static uint32_t cl_prev_valid = 0;
+
+static DRAM_ATTR const char cl_isr[] = "isr";
+static DRAM_ATTR TaskHandle_t cl_idle = NULL;
+static DRAM_ATTR TaskHandle_t cl_last = NULL;
+static DRAM_ATTR uint32_t cl_same = 0;
+static DRAM_ATTR uint32_t cl_susp = 0;
+
+static inline void IRAM_ATTR cl_name(char *dst, TaskHandle_t task) {
+    const char *name = task ? pcTaskGetName(task) : cl_isr;
+    uint32_t i;
+    for (i = 0; i < 7 && name[i]; i++) {
+        dst[i] = name[i];
+    }
+    dst[i] = 0;
+}
+
+static void IRAM_ATTR cl_tick(void) {
+    TaskHandle_t cur = xTaskGetCurrentTaskHandle();
+
+    cl_live.ticks++;
+    if (xTaskGetSchedulerState() == taskSCHEDULER_SUSPENDED) {
+        cl_susp++;
+        if (cl_susp > cl_live.susp_ticks) {
+            cl_live.susp_ticks = cl_susp;
+            cl_live.susp_step = cl_live.step;
+            cl_name(cl_live.susp_name, cur);
+        }
+    }
+    else {
+        cl_susp = 0;
+    }
+    cl_live.cur_susp = cl_susp;
+    if (cur == cl_last && cur != cl_idle) {
+        cl_same++;
+        if (cl_same > cl_live.hog_ticks) {
+            cl_live.hog_ticks = cl_same;
+            cl_live.hog_step = cl_live.step;
+            cl_name(cl_live.hog_name, cur);
+        }
+    }
+    else {
+        cl_same = 0;
+        cl_last = cur;
+        cl_name(cl_live.cur_name, cur);
+    }
+    cl_live.cur_same = cl_same;
+}
+
+/* called by the task watchdog interrupt (IDF weak hook) */
+void esp_task_wdt_isr_user_handler(void) {
+    cl_live.twdt++;
+    cl_live.twdt_step = cl_live.step;
+    cl_name(cl_live.twdt_name, xTaskGetCurrentTaskHandle());
+}
+
+/* software crash: linked with -Wl,--wrap=esp_panic_handler */
+void __real_esp_panic_handler(panic_info_t *info);
+void IRAM_ATTR __wrap_esp_panic_handler(panic_info_t *info) {
+    if (cl_live.magic == CL_MAGIC && !cl_live.panic) {
+        const XtExcFrame *frame = (const XtExcFrame *)info->frame;
+        cl_live.panic = 1;
+        cl_live.panic_pc = (uint32_t)info->addr;
+        cl_live.panic_step = cl_live.step;
+        if (frame) {
+            cl_live.panic_a0 = frame->a0;
+            cl_live.panic_cause = info->pseudo_excause ? (100 + frame->exccause) : frame->exccause;
+        }
+    }
+    __real_esp_panic_handler(info);
+}
+
+void IRAM_ATTR crashlog_written(void) {
+    cl_live.writes++;
+}
+
+void crashlog_disc(void) {
+    cl_live.disc_ticks = cl_live.ticks;
+    cl_live.disc_cnt++;
+}
+
+void crashlog_init(void) {
+    if (cl_live.magic == CL_MAGIC) {
+        memcpy(&cl_prev, &cl_live, sizeof(cl_prev));
+        cl_prev_valid = 1;
+    }
+    memset(&cl_live, 0, sizeof(cl_live));
+    cl_live.magic = CL_MAGIC;
+    cl_idle = xTaskGetIdleTaskHandleForCore(0);
+    esp_register_freertos_tick_hook_for_cpu(cl_tick, 0);
+}
+
+/* previous boot, e.g. "t312 s22 w4 d300/2 H45mc_task Z12s22 W1:BTC_TAS P400d1234/800d5678c28" */
+int crashlog_format(char *buf, uint32_t size) {
+    int len;
+    const crashlog_t *c = &cl_prev;
+
+    if (!cl_prev_valid) {
+        return snprintf(buf, size, " nolog");
+    }
+    len = snprintf(buf, size, " t%lu s%lu w%lu d%lu/%lu H%lu%s@%lu Z%lu%s@%lu",
+        c->ticks / 100, c->step, c->writes, c->disc_ticks / 100, c->disc_cnt,
+        c->hog_ticks, c->hog_name, c->hog_step,
+        c->susp_ticks, c->susp_name, c->susp_step);
+    if (len > 0 && len < (int)size) {
+        len += snprintf(buf + len, size - len, " C%lu/%lu%s", c->cur_same, c->cur_susp, c->cur_name);
+    }
+    if (c->twdt && len > 0 && len < (int)size) {
+        len += snprintf(buf + len, size - len, " W%lu%s@%lu", c->twdt, c->twdt_name, c->twdt_step);
+    }
+    if (c->panic && len > 0 && len < (int)size) {
+        len += snprintf(buf + len, size - len, " P%08lx/%08lxc%lu@%lu",
+            c->panic_pc, c->panic_a0, c->panic_cause, c->panic_step);
+    }
+    return len;
+}
diff --git a/main/system/crashlog.h b/main/system/crashlog.h
new file mode 100644
index 0000000..1a7320c
--- /dev/null
+++ b/main/system/crashlog.h
@@ -0,0 +1,47 @@
+/*
+ * Crash recorder for the Dreamcast VMU build: what the ESP32 was doing when it
+ * reset, kept in RTC memory across the reset and shown on blueretro.io.
+ */
+#ifndef _CRASHLOG_H_
+#define _CRASHLOG_H_
+
+#include <stdint.h>
+
+typedef struct {
+    uint32_t magic;
+    volatile uint32_t step;       /* breadcrumb of the VMU file code */
+    uint32_t writes;              /* 4 KB blocks written to the files */
+    uint32_t ticks;               /* uptime, 10 ms ticks */
+    uint32_t hog_ticks;           /* longest run of one non-idle task on core 0 */
+    uint32_t hog_step;
+    char hog_name[8];
+    uint32_t susp_ticks;          /* longest run with the scheduler suspended (flash access) */
+    uint32_t susp_step;
+    char susp_name[8];
+    uint32_t twdt;                /* task watchdog alarms */
+    uint32_t twdt_step;
+    char twdt_name[8];
+    uint32_t panic;               /* 1 = software crash recorded */
+    uint32_t panic_pc;
+    uint32_t panic_a0;
+    uint32_t panic_cause;
+    uint32_t panic_step;
+    uint32_t disc_ticks;          /* uptime of the last Bluetooth disconnection */
+    uint32_t disc_cnt;
+    uint32_t cur_same;            /* at the last tick: current run of the running task */
+    uint32_t cur_susp;            /* at the last tick: current run with the scheduler suspended */
+    char cur_name[8];             /* at the last tick: running task */
+} crashlog_t;
+
+extern crashlog_t cl_live;
+
+static inline void crashlog_step(uint32_t step) {
+    cl_live.step = step;
+}
+
+void crashlog_init(void);
+void crashlog_written(void);
+void crashlog_disc(void);
+int crashlog_format(char *buf, uint32_t size);
+
+#endif /* _CRASHLOG_H_ */
