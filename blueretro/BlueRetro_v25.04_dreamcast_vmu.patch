+static void dc_page_combo(struct wired_ctrl *ctrl_data) {
+    int32_t idx = ctrl_data->index;
+    uint32_t btns = ctrl_data->btns[0].value;
+    int32_t step = 0;
+
+    if (dc_page_timer == NULL) {
+        const esp_timer_create_args_t args = {
+            .callback = &dc_page_timer_cb,
+            .arg = NULL,
+            .name = "dc_page"
+        };
+        if (esp_timer_create(&args, &dc_page_timer) != ESP_OK) {
+            dc_page_timer = NULL;
+            return;
+        }
+    }
+    if (btns & generic_btns_mask[PAD_MM]) {   /* PAD_MM = Dreamcast Start */
+        /* Start + Y = next page, Start + X = previous page (one of them only:
+         * Start + A + B + X + Y, the soft reset, is left alone) */
+        uint32_t x = btns & generic_btns_mask[PAD_RB_LEFT];
+        uint32_t y = btns & generic_btns_mask[PAD_RB_UP];
+        if (x && !y) {
+            step = -1;
+        }
+        else if (y && !x) {
+            step = 1;
+        }
+    }
+    if (step == 0) {
+        if (dc_page_owner == idx) {
+            esp_timer_stop(dc_page_timer);
+            dc_page_owner = -1;
+            dc_page_dir = 0;
+            dc_page_fired = 0;
+        }
+        return;
+    }
+    if (dc_page_owner == -1 || (dc_page_owner == idx && dc_page_dir != step)) {
+        esp_timer_stop(dc_page_timer);
+        dc_page_owner = idx;
+        dc_page_dir = step;
+        dc_page_fired = 0;
+        dc_page_holds++;
+        esp_timer_start_once(dc_page_timer, DC_PAGE_HOLD_US);
+    }
+}
