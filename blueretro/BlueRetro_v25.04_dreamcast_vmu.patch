+static void bt_att_hid_process_vmu_hdls(struct bt_dev *device,
+        struct bt_att_hid *hid_data, uint32_t att_len, uint8_t *info, uint32_t format) {
+    if (info) {
+        uint16_t last_handle = 0;
+        uint32_t elem_cnt;
+
+        if (format == BT_ATT_INFO_16) {
+            struct bt_att_info_16 *info16 = (struct bt_att_info_16 *)info;
+            elem_cnt = (att_len - 2) / sizeof(*info16);
+            for (uint32_t i = 0; i < elem_cnt; i++) {
+                last_handle = info16[i].handle;
+                if (info16[i].uuid == BT_UUID_GATT_CHRC) {
+                    hid_data->vmu_last = 0;
+                }
+                else if (info16[i].uuid == BT_UUID_GATT_CCC && hid_data->vmu_last == 0x02) {
+                    hid_data->vmu_cfg_hdl = info16[i].handle;
+                }
+            }
+        }
+        else {
+            struct bt_att_info_128 *info128 = (struct bt_att_info_128 *)info;
+            elem_cnt = (att_len - 2) / sizeof(*info128);
+            for (uint32_t i = 0; i < elem_cnt; i++) {
+                uint8_t kind = vmu_uuid_kind(info128[i].uuid);
+                last_handle = info128[i].handle;
+                if (kind == 0x02) {
+                    hid_data->vmu_data_hdl = info128[i].handle;
+                }
+                else if (kind == 0x03) {
+                    hid_data->vmu_ctrl_hdl = info128[i].handle;
+                }
+                hid_data->vmu_last = kind;
+            }
+        }
+
+        if (elem_cnt && last_handle < hid_data->vmu_end_hdl) {
+            bt_att_cmd_find_info_req(device->acl_handle, last_handle + 1, hid_data->vmu_end_hdl);
