+
+/* ---------------- remote VMU ---------------- */
+
+/* esp_timer task: sync timeout, or back to the internal VMU (file read) */
+static void mc_page_switch(int32_t step);
+static void mc_flush_all(void);
+
+static void mc_remote_work(void);
+
+static void mc_remote_cb(void *arg) {
+    if (mc_task_hdl) {
+        xTaskNotify(mc_task_hdl, MC_TASK_REMOTE, eSetBits);
+    }
+    else {
+        mc_remote_work();
+    }
+}
+
+static void mc_task(void *arg) {
+    uint32_t bits;
+
+    while (1) {
+        if (xTaskNotifyWait(0, 0xFFFFFFFF, &bits, portMAX_DELAY) == pdTRUE) {
+            mc_busy = 1;
+            if (bits & MC_TASK_REMOTE) {
+                crashlog_step(30);
+                mc_remote_work();
+            }
+            if (bits & MC_TASK_STORE) {
+                crashlog_step(25);
+                (void)mc_store_spread();
+            }
+            mc_busy = 0;
+            crashlog_step(10);
+        }
+    }
+}
+
+static void mc_remote_work(void) {
+    if (mc_page_req && (mc_remote_state == MC_REMOTE_OFF || mc_remote_state == MC_REMOTE_ON)) {
+        int32_t step = mc_page_req;
+        mc_page_req = 0;
+        mc_page_switch(step);
+        return;
+    }
+    mc_page_req = 0;
+    if (mc_mirror_check) {
+        mc_mirror_check = 0;
+        if (mc_remote_state == MC_REMOTE_ON && mc_page == 0) {
+            static uint8_t tmp[512];
+            FILE *file = fopen(mc_page_file(0), "rb");
+            uint32_t diff = 0;
+            for (uint32_t i = 0; i < MC_BUFFER_BLOCK_CNT; i++) {
+                uint32_t same = (file != NULL);
+                for (uint32_t k = 0; k < MC_BUFFER_BLOCK_SIZE / 512; k++) {
+                    if (file == NULL || fread(tmp, 512, 1, file) != 1) {
+                        same = 0;
+                        break;
+                    }
+                    if (same && memcmp(tmp, mc_buffer[i] + k * 512, 512) != 0) {
+                        same = 0;   /* keep reading to stay aligned */
+                    }
+                }
+                if (!same) {
+                    MC_SET_BIT(&mc_block_state, i);
+                    diff++;
+                }
+            }
+            if (file) {
+                fclose(file);
+            }
+            printf("# %s: mirror, %ld blocks to update\n", __FUNCTION__, diff);
+            if (mc_block_state) {
+                mc_start_update_timer(20000);
+            }
+        }
+        return;
+    }
+    if (mc_remote_state == MC_REMOTE_PREP) {
+        /* save what is pending on the current page, then page 1 receives the pad copy */
+        mc_flush_all();
+        mc_page = 0;
+        mc_block_state = 0;
+        mc_remote_bytes = 0;
+        mc_remote_state = MC_REMOTE_SYNC;
+        esp_timer_start_once(mc_remote_timer_hdl, MC_REMOTE_TIMEOUT_US);
+        mc_remote_req_pending = 1;
+        mc_kick_fb();
+        printf("# %s: page 1, waiting for the pad VMU\n", __FUNCTION__);
+        return;
+    }
+    if (mc_remote_state == MC_REMOTE_SYNC) {
+        printf("# %s: remote VMU sync timeout (%ld bytes)\n", __FUNCTION__, mc_remote_bytes);
+        mc_hidden = 1;
+        mc_remote_state = MC_REMOTE_RESTORE;
+    }
+    if (mc_remote_state == MC_REMOTE_LEAVE) {
+        /* the buffer is the mirror: write what is left, keep it as the internal VMU */
+        mc_remote_state = MC_REMOTE_OFF;
+        while (mc_block_state) {
+            if (mc_store_spread() != 0) {
+                break;
+            }
+        }
+        if (mc_timer_hdl && esp_timer_is_active(mc_timer_hdl)) {
+            esp_timer_stop(mc_timer_hdl);
+        }
+        mc_remote_dev = -1;
+        mc_remote_send = NULL;
+        mc_hidden = 0;
+        printf("# %s: pad gone, internal VMU = mirror of the pad VMU\n", __FUNCTION__);
+        return;
+    }
+    if (mc_remote_state == MC_REMOTE_RESTORE) {
+        (void)mc_restore();
+        mc_block_state = 0;
+        mc_remote_dev = -1;
+        mc_remote_send = NULL;
+        mc_remote_state = MC_REMOTE_OFF;
+        mc_hidden = 0;
+        printf("# %s: internal VMU back\n", __FUNCTION__);
+    }
+}
+
+static void mc_remote_abort(void) {
+    mc_hidden = 1;
+    mc_remote_on = 0;
+    mc_remote_state = (mc_remote_state == MC_REMOTE_ON) ? MC_REMOTE_LEAVE : MC_REMOTE_RESTORE;
+    if (mc_remote_timer_hdl) {
+        if (esp_timer_is_active(mc_remote_timer_hdl)) {
+            esp_timer_stop(mc_remote_timer_hdl);
+        }
+        /* file access out of the Bluetooth context; short delay = VMU "unplugged" for the console */
+        esp_timer_start_once(mc_remote_timer_hdl, 100000);
+    }
+}
+
+static int32_t mc_remote_timer_init(void) {
+    if (mc_remote_timer_hdl == NULL) {
+        const esp_timer_create_args_t args = {
+            .callback = &mc_remote_cb,
+            .arg = (void *)NULL,
+            .name = "mc_remote"
+        };
+        if (esp_timer_create(&args, &mc_remote_timer_hdl) != ESP_OK) {
+            mc_remote_timer_hdl = NULL;
+            return -1;
+        }
+    }
+    return 0;
+}
+
+int32_t mc_remote_begin(int32_t dev_id, mc_remote_send_t send, void (*req)(int32_t dev_id)) {
+    if (mc_timer_hdl == NULL || mc_remote_state != MC_REMOTE_OFF) {
+        return -1;
+    }
+    if (mc_remote_timer_init() != 0) {
+        return -1;
+    }
+    if (esp_timer_is_active(mc_remote_timer_hdl)) {
+        esp_timer_stop(mc_remote_timer_hdl);
+    }
+    if (mc_timer_hdl && esp_timer_is_active(mc_timer_hdl)) {
+        esp_timer_stop(mc_timer_hdl);
+    }
+    mc_hidden = 1;
+    mc_remote_on = 0;
+    mc_remote_bytes = 0;
+    mc_remote_dev = dev_id;
+    mc_remote_send = send;
+    mc_remote_req = req;
+    mc_page_req = 0;
+    mc_remote_lcd_pending = 0;
+    memset(mc_remote_phases, 0, sizeof(mc_remote_phases));
+    memset(mc_remote_ready, 0, sizeof(mc_remote_ready));
+    /* pending saves and the switch to page 1 are done by the timer task (file access) */
+    mc_remote_state = MC_REMOTE_PREP;
+    esp_timer_start_once(mc_remote_timer_hdl, 1000);
+    printf("# %s: dev %ld, preparing page 1 for the pad VMU\n", __FUNCTION__, dev_id);
+    return 0;
+}
+
+/* Notifications from the pad:
+ *  0x10 block offset_lo offset_hi data... : part of a 512-byte block (wire byte order)
+ *  0x11 code : 0x01 start, 0x02 end, 0xE0 no VMU in the pad, 0xE1 VMU read error */
+void mc_remote_rx(const uint8_t *data, uint32_t len) {
+    if (mc_remote_state != MC_REMOTE_SYNC || len < 2) {
+        return;
+    }
+    if (data[0] == 0x10 && len > 4) {
+        uint32_t block = data[1];
+        uint32_t offset = data[2] | (data[3] << 8);
+        uint32_t size = len - 4;
+        if (offset + size <= 512) {
+            memcpy(mc_get_ptr(block * 512 + offset), data + 4, size);
+            mc_remote_bytes += size;
+        }
+    }
+    else if (data[0] == 0x11) {
+        switch (data[1]) {
+            case 0x01:
+                esp_timer_stop(mc_remote_timer_hdl);
+                esp_timer_start_once(mc_remote_timer_hdl, MC_REMOTE_TIMEOUT_US);
+                break;
+            case 0x02:
+                if (mc_remote_bytes == MC_BUFFER_SIZE) {
+                    esp_timer_stop(mc_remote_timer_hdl);
+                    mc_remote_state = MC_REMOTE_ON;
+                    mc_remote_on = 1;
+                    mc_hidden = 0;
+                    /* mirror: the whole copy replaces the internal VMU file */
+                    if (config.global_cfg.banksel < CONFIG_BANKSEL_MAX) {
+                        /* the timer task writes only the 4 KB blocks that differ */
+                        mc_mirror_check = 1;
+                        esp_timer_start_once(mc_remote_timer_hdl, 1000);
+                    }
+                    printf("# %s: pad VMU ready, mirrored in the internal VMU\n", __FUNCTION__);
+                }
+                else {
+                    printf("# %s: pad VMU incomplete (%ld bytes)\n", __FUNCTION__, mc_remote_bytes);
+                    mc_remote_abort();
+                }
+                break;
+            default:
+                printf("# %s: pad reports 0x%02X, internal VMU kept\n", __FUNCTION__, data[1]);
+                mc_remote_abort();
+                break;
+        }
+    }
+}
+
+void mc_remote_end(int32_t dev_id) {
+    if ((mc_remote_state == MC_REMOTE_SYNC || mc_remote_state == MC_REMOTE_ON
+        || mc_remote_state == MC_REMOTE_PREP) && dev_id == mc_remote_dev) {
+        printf("# %s: pad disconnected\n", __FUNCTION__);
+        mc_remote_abort();
+    }
+}
+
+/* Bluetooth feedback task: sends finished blocks and the screen to the pad.
+ *  0x02 block phase data[128] : one quarter of a block (the 4 are sent in a row)
+ *  0x03 data[192]             : VMU screen */
+static void mc_remote_flush(void) {
+    static uint8_t msg[1 + 192];
+
+    if (mc_remote_state != MC_REMOTE_ON || mc_remote_send == NULL) {
+        return;
+    }
+    for (uint32_t w = 0; w < 8; w++) {
+        uint32_t bits = __atomic_exchange_n(&mc_remote_ready[w], 0, __ATOMIC_SEQ_CST);
+        while (bits) {
+            uint32_t bit = __builtin_ctz(bits);
+            uint32_t block = w * 32 + bit;
+            bits &= ~(1u << bit);
+            for (uint32_t phase = 0; phase < 4; phase++) {
+                msg[0] = 0x02;
+                msg[1] = block;
+                msg[2] = phase;
+                memcpy(&msg[3], mc_get_ptr(block * 512 + phase * 128), 128);
+                mc_remote_send(mc_remote_dev, msg, 3 + 128);
+            }
+            printf("# %s: block %ld sent to the pad\n", __FUNCTION__, block);
+        }
+    }
+    if (mc_remote_lcd_pending) {
+        mc_remote_lcd_pending = 0;
+        msg[0] = 0x03;
+        memcpy(&msg[1], mc_remote_lcd_buf, 192);
+        mc_remote_send(mc_remote_dev, msg, 1 + 192);
+    }
+}
+
+/* ---------------- pages ---------------- */
+
+/* Writes every pending block of the current page in its file (timer task) */
+static void mc_flush_all(void) {
+    uint32_t state = mc_remote_state;
+    if (mc_remote_state != MC_REMOTE_ON && mc_remote_state != MC_REMOTE_PREP) {
+        mc_remote_state = MC_REMOTE_OFF;
+    }
+    for (uint32_t i = 0; i < MC_BUFFER_BLOCK_CNT && mc_block_state; i++) {
+        if (mc_store_spread() != 0) {
+            break;
+        }
+    }
+    if (mc_timer_hdl && esp_timer_is_active(mc_timer_hdl)) {
+        esp_timer_stop(mc_timer_hdl);
+    }
+    mc_remote_state = state;
+}
+
+/* Byte of the VMU image at file offset 'off' of a block; the buffer keeps the
+ * bus order, which may have each 32-bit word reversed: 'swap' selects it. */
+static inline uint8_t *mc_vb(uint8_t *blk, uint32_t off, uint32_t swap) {
+    return swap ? &blk[(off & ~3u) | (3 - (off & 3))] : &blk[off];
+}
+
+static inline uint32_t mc_vb16(uint8_t *blk, uint32_t off, uint32_t swap) {
+    return *mc_vb(blk, off, swap) | (*mc_vb(blk, off + 1, swap) << 8);
+}
+
+/* New page: an unformatted VMU (all zero). The Dreamcast BIOS formats it
+ * with its own official layout (homemade formatting confused openMenu). */
+static void mc_page_blank(void) {
+    for (uint32_t i = 0; i < MC_BUFFER_BLOCK_CNT; i++) {
+        memset(mc_buffer[i], 0, MC_BUFFER_BLOCK_SIZE);
+    }
+    printf("# %s: new unformatted page\n", __FUNCTION__);
+}
+
+/* VMU screen of the pad: "PAGE n", until the console draws the screen again */
+static void mc_page_show(void) {
+    static uint8_t msg[1 + 192];
+
+    if (!mc_remote_on || mc_remote_send == NULL) {
+        return;
+    }
+    (void)msg;
+    memcpy(mc_remote_lcd_buf, mc_page_lcd[mc_page % MC_PAGE_CNT], 192);
+    mc_remote_lcd_pending = 1;
+    mc_kick_fb();
+}
+
+static void mc_page_switch(int32_t step) {
+    uint32_t prev = mc_page;
+    uint32_t next = (mc_page + MC_PAGE_CNT + step) % MC_PAGE_CNT;
+    struct stat st;
+
+    if (mc_remote_state == MC_REMOTE_ON && mc_page == 0) {
+        uint32_t owed = 0;
+        for (uint32_t w = 0; w < 8; w++) {
+            owed |= mc_remote_ready[w];
+        }
+        if (owed) {
+            /* blocks still owed to the pad's VMU: let the feedback task send
+             * them first, then switch */
+            mc_kick_fb();
+            mc_page_req = step;
+            esp_timer_start_once(mc_remote_timer_hdl, 200000);
+            return;
+        }
+    }
+    mc_hidden = 1;          /* the console sees the VMU unplugged */
+    mc_flush_all();
+    if (mc_block_state) {
+        /* the current page could not be saved: stay on it, nothing is lost */
+        mc_fs_errors++;
+        printf("# %s: page %ld not saved, switch cancelled\n", __FUNCTION__, prev + 1);
+        mc_start_update_timer(1000000);
+        goto done;
+    }
+    if (stat(mc_page_file(next), &st) != 0) {
+        if (mc_fs_free() < MC_PAGE_MIN_FREE) {
+            mc_fs_errors++;
+            printf("# %s: not enough room for page %ld (%d free)\n", __FUNCTION__, next + 1, mc_fs_free());
+            goto done;
+        }
+        mc_page_blank();    /* template = page still in RAM */
+        mc_page = next;
+        if (mc_store() != 0) {
+            remove(mc_page_file(next));
+            mc_page = prev;
+            (void)mc_restore();
+            goto done;
+        }
+    }
+    else if (st.st_size != MC_BUFFER_SIZE) {
+        mc_fs_errors++;
+        printf("# %s: page %ld file damaged (%ld bytes)\n", __FUNCTION__, next + 1, st.st_size);
+        goto done;
+    }
+    else {
+        mc_page = next;
+        if (mc_restore() != 0) {
+            mc_page = prev;
+            (void)mc_restore();
+            goto done;
+        }
+    }
+    mc_block_state = 0;
+    memset(mc_remote_phases, 0, sizeof(mc_remote_phases));
+    memset(mc_remote_ready, 0, sizeof(mc_remote_ready));
+
+done:
+    printf("# %s: page %ld\n", __FUNCTION__, mc_page + 1);
+    mc_page_show();
+    mc_hidden = 0;
+}
+
+/* From the controller code: Start + Y / Start + X held. Done by the timer task. */
+void mc_page_step(int32_t step) {
+    if (mc_timer_hdl == NULL || mc_remote_timer_init() != 0) {
+        return;
+    }
+    if (mc_remote_state != MC_REMOTE_OFF && mc_remote_state != MC_REMOTE_ON) {
+        return;
+    }
+    if (esp_timer_is_active(mc_remote_timer_hdl) || mc_busy || mc_page_req) {
+        return;
+    }
+    mc_page_req = step;
+    esp_timer_start_once(mc_remote_timer_hdl, 1000);
+}
+
+uint32_t mc_page_get(void) {
+    return mc_page;
+}
