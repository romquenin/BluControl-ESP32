+static const uint8_t vmu_uuid_base[16] = {
+    0x20, 0x3b, 0x9e, 0x5a, 0x7c, 0x0d, 0x61, 0x9f,
+    0x2e, 0x4c, 0x3a, 0x5b, 0x01, 0x00, 0x1e, 0x7d,
