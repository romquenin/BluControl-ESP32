+/**
+ * @brief Directed connectable advertising (high duty cycle) towards one bonded peer:
+ * the BLE equivalent of a classic controller paging its host to reconnect.
+ * @param [in] peer Address of the host to call.
+ * @param [in] duration_ms Duration (the controller stops high duty directed ads after 1.28 s).
+ * @return True if started.
+ */
+/* STATIC */
+bool NimBLEDevice::startDirectedAdvertising(const ble_addr_t *peer, int32_t duration_ms) {
+#if defined(CONFIG_BT_NIMBLE_ROLE_PERIPHERAL)
+    if (ble_gap_adv_active()) {
+        ble_gap_adv_stop();
+    }
+    struct ble_gap_adv_params params;
+    memset(&params, 0, sizeof(params));
+    params.conn_mode = BLE_GAP_CONN_MODE_DIR;
+    params.disc_mode = BLE_GAP_DISC_MODE_NON;
+    params.high_duty_cycle = 1;
+    int rc = ble_gap_adv_start(m_own_addr_type, peer, duration_ms, &params,
+                               NimBLEServer::handleGapEvent, (void*)getAdvertising());
+    if (rc != 0) {
+        NIMBLE_LOGE(LOG_TAG, "Directed advertising failed: rc=%d", rc);
+    }
+    return rc == 0;
+#else
+    return false;
+#endif
+} // startDirectedAdvertising
