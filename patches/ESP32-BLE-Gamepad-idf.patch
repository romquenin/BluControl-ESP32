diff --git a/BleGamepad.cpp b/BleGamepad.cpp
index cf91a38..ae89d56 100644
--- a/BleGamepad.cpp
+++ b/BleGamepad.cpp
@@ -1,3 +1,5 @@
+#include "esp_mac.h"
+#include "esp_random.h"
 #include <NimBLEDevice.h>
 #include <NimBLEUtils.h>
 #include <NimBLEServer.h>
@@ -1428,7 +1430,22 @@ void BleGamepad::taskServer(void *pvParameter)
     //uint8_t newMACAddress[] = {0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF - 0x02};
     //esp_base_mac_addr_set(&newMACAddress[0]); // Set new MAC address 
     
+#ifdef CONFIG_BLUCONTROL_BLE_NEW_ADDRESS_EACH_BOOT
+    /* New random (locally administered, unicast) base MAC for this boot: the
+     * Bluetooth address changes at every power-on, so the host pairs again from
+     * scratch every time (its "first pairing" path always works). */
+    {
+        uint8_t mac[6];
+        esp_fill_random(mac, sizeof(mac));
+        mac[0] = (mac[0] & 0xFC) | 0x02;
+        esp_base_mac_addr_set(mac);
+    }
+#endif
     NimBLEDevice::init(BleGamepadInstance->deviceName);
+#ifdef CONFIG_BLUCONTROL_BLE_NEW_ADDRESS_EACH_BOOT
+    /* old pairings belong to previous addresses: never needed again */
+    NimBLEDevice::deleteAllBonds();
+#endif
     NimBLEServer *pServer = NimBLEDevice::createServer();
     pServer->setCallbacks(BleGamepadInstance->connectionStatus);
 
