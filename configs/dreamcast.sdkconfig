#
# BluControl Switch Configuration
# Dreamcast pad (PCB 171-8044B) read through its Maple bus, ON/OFF switch
#
CONFIG_BLUCONTROL_CONTROL_TYPE_PRO=y
# CONFIG_BLUCONTROL_CONTROL_TYPE_N64 is not set
# CONFIG_BLUCONTROL_CONTROL_TYPE_JOY_L is not set
# CONFIG_BLUCONTROL_CONTROL_TYPE_JOY_R is not set
# CONFIG_BLUCONTROL_CONTROL_TYPE_SNES is not set
# CONFIG_BLUCONTROL_CONTROL_TYPE_NES is not set
# CONFIG_BLUCONTROL_CONTROL_TYPE_FC is not set
# CONFIG_BLUCONTROL_CONTROL_TYPE_GENESIS is not set

#
# Triggers
#
# end of Triggers
# end of BluControl Switch Configuration

#
# BluControl Generic Configuration
#
CONFIG_BLUCONTROL_BUTTONS_LENGTH=0
# BlueRetro generic HID order: 1=A 2=B 4=X 5=Y 12=Start (Dreamcast output)
CONFIG_BLUCONTROL_BUTTON_A_BTN=1
CONFIG_BLUCONTROL_BUTTON_B_BTN=2
CONFIG_BLUCONTROL_BUTTON_X_BTN=4
CONFIG_BLUCONTROL_BUTTON_Y_BTN=5
CONFIG_BLUCONTROL_BUTTON_L_BTN=0
CONFIG_BLUCONTROL_BUTTON_ZL_BTN=0
CONFIG_BLUCONTROL_BUTTON_R_BTN=0
CONFIG_BLUCONTROL_BUTTON_ZR_BTN=0
CONFIG_BLUCONTROL_BUTTON_START_BTN=12
CONFIG_BLUCONTROL_BUTTON_SELECT_BTN=0
CONFIG_BLUCONTROL_BUTTON_HOME_BTN=0
CONFIG_BLUCONTROL_BUTTON_CAPTURE_BTN=0
CONFIG_BLUCONTROL_BUTTON_STICK_L_BTN=0
CONFIG_BLUCONTROL_BUTTON_STICK_R_BTN=0
CONFIG_BLUCONTROL_DREAMCAST=y
CONFIG_BLUCONTROL_MAPLE_A_GPIO=21
CONFIG_BLUCONTROL_MAPLE_B_GPIO=22

#
# BluControl Configuration
#
CONFIG_BLUCONTROL_BUTTONS_PRESS_STATE_LOW=y
# CONFIG_BLUCONTROL_BUTTONS_PRESS_STATE_HIGH is not set
# All buttons come from the Maple bus: no button GPIO
CONFIG_BLUCONTROL_BUTTON_A_GPIO=""
CONFIG_BLUCONTROL_BUTTON_B_GPIO=""
CONFIG_BLUCONTROL_BUTTON_Y_GPIO=""
CONFIG_BLUCONTROL_BUTTON_X_GPIO=""
CONFIG_BLUCONTROL_DPAD_RIGHT_GPIO=""
CONFIG_BLUCONTROL_DPAD_DOWN_GPIO=""
CONFIG_BLUCONTROL_DPAD_LEFT_GPIO=""
CONFIG_BLUCONTROL_DPAD_UP_GPIO=""
CONFIG_BLUCONTROL_BUTTON_L_GPIO=""
CONFIG_BLUCONTROL_BUTTON_ZL_GPIO=""
CONFIG_BLUCONTROL_BUTTON_R_GPIO=""
CONFIG_BLUCONTROL_BUTTON_ZR_GPIO=""
CONFIG_BLUCONTROL_BUTTON_START_GPIO=""
CONFIG_BLUCONTROL_BUTTON_SELECT_GPIO=""
CONFIG_BLUCONTROL_BUTTON_HOME_GPIO=""
CONFIG_BLUCONTROL_BUTTON_CAPTURE_GPIO=""
CONFIG_BLUCONTROL_BUTTON_STICK_L_GPIO=""
CONFIG_BLUCONTROL_BUTTON_STICK_R_GPIO=""
CONFIG_BLUCONTROL_LEFT_TRIGGER_NONE=y
# CONFIG_BLUCONTROL_LEFT_TRIGGER_ANALOG is not set
CONFIG_BLUCONTROL_RIGHT_TRIGGER_NONE=y
# CONFIG_BLUCONTROL_RIGHT_TRIGGER_ANALOG is not set
CONFIG_BLUCONTROL_LEFT_STICK_NONE=y
# CONFIG_BLUCONTROL_LEFT_STICK_ANALOG is not set
# CONFIG_BLUCONTROL_LEFT_STICK_N64 is not set
# CONFIG_BLUCONTROL_LEFT_STICK_BUTTONS is not set
CONFIG_BLUCONTROL_RIGHT_STICK_NONE=y
# CONFIG_BLUCONTROL_RIGHT_STICK_ANALOG is not set
# CONFIG_BLUCONTROL_RIGHT_STICK_N64 is not set
# CONFIG_BLUCONTROL_RIGHT_STICK_BUTTONS is not set

#
# Energy control: real ON/OFF switch on the battery
#
CONFIG_BLUCONTROL_ENERGY_MODE_SWITCH=y
# CONFIG_BLUCONTROL_ENERGY_MODE_SOFTWARE is not set
# CONFIG_BLUCONTROL_LEDS_MODE_HIGH is not set
CONFIG_BLUCONTROL_LEDS_MODE_LOW=y

#
# BluControl SDK Configuration
#
CONFIG_BLUCONTROL_MODE_LENGTH=2
# Red = Switch mode, blue = BlueRetro mode
CONFIG_BLUCONTROL_MODE1_LED_GPIO=4
CONFIG_BLUCONTROL_MODE2_LED_GPIO=33
CONFIG_BLUCONTROL_SECONDS_FOR_SWITCH_MODE=5
# Mode switch is read on the Maple bus (Start + A 5 s), not on GPIOs
CONFIG_BLUCONTROL_SWITCH_BUTTONS_LENGTH=1
CONFIG_BLUCONTROL_SWITCH_BUTTON1_GPIO=-1

#
# BluControl OTA Configuration
#
CONFIG_BLUCONTROL_OTA_LED_GPIO=33
CONFIG_BLUCONTROL_OTA_LED_ACTIVE_LOW=y
CONFIG_BLUCONTROL_OTA_POWER_BUTTON_GPIO=-1
CONFIG_BLUCONTROL_OTA_TIMEOUT_MIN=15

# Maple bus timing: full CPU speed
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# CONFIG_ESP32_DEFAULT_CPU_FREQ_160 is not set
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240
